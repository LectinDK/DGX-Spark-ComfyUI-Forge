# ============================================================
# DGX-Spark-ComfyUI-Forge-Docker – Environment-Konfiguration
# ============================================================
# Kopieren nach ".env" und an die eigene Umgebung anpassen:
#   cp .env.example .env
#
# WICHTIG: .env NIEMALS committen (enthält lokale Pfade).
# Diese Datei (.env.example) ist die öffentliche Vorlage.
# ============================================================

# ---- Pfade (unbedingt anpassen!) ----

# Ordner mit deinen ComfyUI-Modellen (checkpoints/, vae/, loras/, ...).
# Wird nach /models im Container gemountet.
COMFYUI_HOST_PATH=/home/DEIN_USERNAME/UNTERVERZEICHNIS(optional)/models

# Persistenter Datenordner für dieses Setup (Custom Nodes, Outputs,
# Inputs, User-Settings, Paket-venv). Getrennt vom geklonten Repo-Ordner!
FORGE_DATA_PATH=/home/DEIN_USERNAME/UNTERVERZEICHNIS(optional)/DGX-Spark-ComfyUI-Forge

# ---- Netzwerk ----

# Host-seitiger Port, über den ComfyUI erreichbar ist.
# Intern lauscht der Container immer auf 8188 (nicht ändern, siehe
# docker-compose.yml/entrypoint.sh).
COMFYUI_PORT=8190

# ---- Build-Referenzen (Versionen/Commits) ----
# Siehe PROJECT_CONTEXT.md für die Begründung jedes einzelnen Werts.
# Nicht leichtfertig auf "master"/"main" bei ComfyUI selbst ändern.

BASE=nvcr.io/nvidia/pytorch:26.07-py3
COMFYUI_REF=v0.33.1
SAGEATTN_REF=main
TORCHAUDIO_REF=v2.11.0
XFORMERS_REF=v0.0.32

# ---- Build-Optionen ----

MAX_JOBS=8
BUILD_XFORMERS=1
BUILD_SAGE_ATTN=1
BUILD_TORCHAUDIO=1
INSTALL_TRITON=1

# ---- ComfyUI Laufzeit-Flags ----
# Optimized flags for Grace-Blackwell unified memory architecture
# Key: DON'T use --gpu-only - it fights the unified memory fabric
# --disable-pinned-memory: reduces overhead on unified fabric
# --force-fp16 + --fp16-*: enables Flash Attention optimization
# --dont-upcast-attention: keeps attention in FP16 for speed
# --disable-mmap: together with the patch in the Dockerfile fixes the double memory usage on unified memory on the Spark

COMFYUI_EXTRA_ARGS=--dont-upcast-attention --reserve-vram 1 --disable-pinned-memory --disable-dynamic-vram --use-sage-attention --disable-mmap --database-url sqlite:////user/comfyui.db
