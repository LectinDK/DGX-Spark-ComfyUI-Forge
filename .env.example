# ============================================================
# DGX-Spark-ComfyUI-Forge-Docker – Environment Configuration
# ============================================================
# Copy to ".env" and adjust to your own environment:
#   cp .env.example .env
#
# IMPORTANT: never commit .env (contains local paths).
# This file (.env.example) is the public template.
# ============================================================

# ---- Paths (must be adjusted!) ----

# Folder with your existing ComfyUI models (checkpoints/, vae/, loras/, ...).
# Mounted to /models inside the container.
COMFYUI_HOST_PATH=/home/YOUR_USERNAME/SUBDIRECTORY(optional)/models

# Persistent data folder for this setup (custom nodes, outputs,
# inputs, user settings, package venv). Must be separate from the
# cloned repo folder!
FORGE_DATA_PATH=/home/YOUR_USERNAME/SUBDIRECTORY(optional)/DGX-Spark-ComfyUI-Forge

# ---- Network ----

# Host-side port ComfyUI is reachable on.
# The container always listens on 8188 internally (do not change,
# see docker-compose.yml/entrypoint.sh).
COMFYUI_PORT=8190

# ---- Build references (versions/commits) ----
# Don't casually change ComfyUI itself to "master"/"main" - see the
# design-decisions section in README.md for why most refs are pinned.
# ComfyUI-Manager's version isn't pinned separately - it's bundled via
# ComfyUI's own manager_requirements.txt and tracks COMFYUI_REF.

BASE=nvcr.io/nvidia/pytorch:26.07-py3
COMFYUI_REF=v0.33.1
SAGEATTN_REF=main
TORCHAUDIO_REF=v2.11.0
XFORMERS_REF=v0.0.32

# ---- Build options ----

MAX_JOBS=8
BUILD_XFORMERS=1
BUILD_SAGE_ATTN=1
BUILD_TORCHAUDIO=1
INSTALL_TRITON=1

# ---- ComfyUI runtime flags ----
# Optimized flags for Grace-Blackwell unified memory architecture.
# Key: DON'T use --gpu-only - it fights the unified memory fabric.
# --disable-pinned-memory: reduces overhead on the unified fabric
# --dont-upcast-attention: keeps attention in FP16 for speed
# --disable-mmap: together with the Dockerfile patch, fixes double
#   memory usage on the Spark's unified memory
# --enable-manager: required for ComfyUI's bundled Manager to load in
#   non-desktop environments (see README design decisions)
# Deliberately NOT using --force-fp16/--bf16-*: no effect (or
# actively risky) for mixed-precision-quantized checkpoints
# (nvfp4/int8-convrot via comfy_kitchen)

COMFYUI_EXTRA_ARGS=--enable-manager --use-sage-attention --disable-pinned-memory --disable-mmap --database-url sqlite:////user/comfyui.db